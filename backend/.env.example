PORT=5038
# Optional. If omitted, the API uses an in-memory store with demo seed data.
MONGO_URI=
DB_NAME=examdb
# Optional. If omitted, grading uses a local NLP heuristic so the demo still works.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated origins for CORS. Use * for local demos.
FRONTEND_ORIGIN=http://localhost:5173
# Used to sign demo login tokens. Change this in production.
AUTH_SECRET=change-me-in-production
